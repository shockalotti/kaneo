# Normalize line endings to LF in the repository for all text files.
# Git will convert to OS-native endings on checkout (CRLF on Windows, LF on Mac/Linux).
# This ensures CI linters (Biome) always see LF regardless of developer OS.
* text=auto eol=lf

# Explicitly mark binary files to prevent any conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.zip binary
*.gz binary
*.tar binary
